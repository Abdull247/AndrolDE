<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/item_cd"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:rippleColor="#20607D8B"
		app:strokeWidth="0dp"
		app:strokeColor="#60607D8B"
		app:cardCornerRadius="0dp"
		app:cardElevation="0dp"
		app:cardBackgroundColor="#00000000">
		<LinearLayout
			android:id="@+id/linear1"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingLeft="8dp"
			android:paddingRight="8dp"
			android:gravity="center_vertical"
			android:orientation="horizontal">
			<ImageView
				android:id="@+id/stage_icon"
				android:focusable="false"
				android:layout_width="25dp"
				android:layout_height="25dp"
				android:src="@drawable/css_icon"
				android:scaleType="fitCenter" />
			<LinearLayout
				android:id="@+id/linear2"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:paddingLeft="8dp"
				android:paddingTop="4dp"
				android:paddingRight="8dp"
				android:paddingBottom="4dp"
				android:gravity="center_vertical"
				android:orientation="vertical"
				android:layout_weight="1">
				<TextView
					android:id="@+id/file_name"
					android:focusable="false"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="app.css"
					android:textSize="16sp"
					android:textColor="?attr/colorOnSurface" />
				<TextView
					android:id="@+id/file_path"
					android:focusable="false"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="src/app.css"
					android:textSize="12sp"
					android:textColor="#9E9E9E" />
			</LinearLayout>
			<ImageView
				android:id="@+id/diff_icon"
				android:focusable="false"
				android:layout_width="25dp"
				android:layout_height="25dp"
				android:layout_marginLeft="8dp"
				android:layout_marginRight="8dp"
				android:src="@drawable/icon_plus_minus_round"
				android:scaleType="fitCenter" />
			<ImageView
				android:id="@+id/plus_btn"
				android:focusable="false"
				android:layout_width="25dp"
				android:layout_height="25dp"
				android:layout_marginRight="8dp"
				android:src="@drawable/icon_add_circle_outline_round"
				android:scaleType="fitCenter" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
