<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/_coordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">
			<ImageView
				android:id="@+id/imageview1"
				android:layout_width="63dp"
				android:layout_height="63dp"
				android:padding="8dp"
				android:src="@drawable/back"
				android:scaleType="center"
				android:tint="?attr/colorOnSurface" />
			<TextView
				android:id="@+id/textview1"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="AndroIDE"
				android:textSize="20sp"
				android:textColor="?colorOnSurface"
				android:fontFamily="@font/enbold" />
			<LinearLayout
				android:id="@+id/linear3"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="right|center_vertical"
				android:orientation="horizontal"
				android:layout_weight="1">
				<ImageView
					android:id="@+id/imageview2"
					android:layout_width="63dp"
					android:layout_height="63dp"
					android:padding="4dp"
					android:src="@drawable/search"
					android:scaleType="center"
					android:tint="?attr/colorOnSurface" />
				<ImageView
					android:id="@+id/imageview3"
					android:layout_width="63dp"
					android:layout_height="63dp"
					android:padding="4dp"
					android:src="@drawable/menu"
					android:scaleType="center"
					android:tint="?attr/colorOnSurface" />
			</LinearLayout>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/back"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:paddingBottom="15dp"
			android:orientation="vertical">
			<com.google.android.material.progressindicator.LinearProgressIndicator
				android:id="@+id/progressbar1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="horizontal" />
			<com.google.android.material.tabs.TabLayout
				android:id="@+id/tablayout1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:tabMode="scrollable"
				app:tabTextColor="?attr/colorOnSurface"
				app:tabIndicatorColor="?attr/colorPrimary"
				app:tabSelectedTextColor="?attr/colorPrimary"
				android:elevation="0dp"
				app:tabIndicatorFullWidth="false"
				app:tabIndicator="@drawable/tab_des"
				app:tabIndicatorHeight="4dp" />
			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/recyclerview1"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				tools:listitem="@layout/lib_cus_item" />
			<LinearLayout
				android:id="@+id/empty_view"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical">
				<com.airbnb.lottie.LottieAnimationView
					android:id="@+id/lottie1"
					android:layout_width="240dp"
					android:layout_height="240dp"
					android:padding="8dp"
					android:layout_gravity="center_horizontal|center_vertical"
					android:scaleType="fitCenter"
					android:layout_centerInParent="true"
					app:lottie_fileName="your_file.json"
					app:lottie_loop="true"
					app:lottie_autoPlay="true" />
				<TextView
					android:id="@+id/textview2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:gravity="center_horizontal"
					android:text="No file found!"
					android:textSize="16sp"
					android:layout_gravity="center_horizontal|center_vertical"
					android:textColor="?colorOnSurface"
					android:fontFamily="@font/enmedium" />
			</LinearLayout>
		</LinearLayout>
	</LinearLayout>
	<com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
android:text="Create or Import a New File"
app:icon="@drawable/add"
		android:id="@+id/_fab"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_margin="16dp"
		android:layout_gravity="right|bottom" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
